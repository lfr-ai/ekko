# ─── Base Runtime Defaults ───────────────────────────────────────────────
# Shared defaults for all environments. Copy to `.env` and fill in values.
#
# Setup:  cp .env.example .env
#         (then fill in real values)
#
# Per-environment overrides live in the matching .env.<env> file.
# Resolution precedence: process env > .env.local > .env.<env> > .env
# ─────────────────────────────────────────────────────────────────────────

# ─── Docker Compose behavior ────────────────────────────────────────────
# Auto-load compose base+override files and both env files.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker/compose.yaml:docker/compose.override.yaml
COMPOSE_ENV_FILES=.env,.env.local

# Optional observability profile (include compose.observability.yaml manually)
# Example:
# docker compose -f docker/compose.yaml -f docker/compose.override.yaml -f docker/compose.observability.yaml --profile observability up --build

# Optional analytics profile (include compose.analytics.yaml manually)
# Example:
# docker compose -f docker/compose.yaml -f docker/compose.override.yaml -f docker/compose.analytics.yaml --profile analytics up --build

# ─── Azure Speech Services (STT) — REQUIRED ─────────────────────────────
# Get your credentials from https://portal.azure.com
# Create a "Speech Services" resource and copy KEY 1 and REGION
EKKO_AZURE_SPEECH_KEY=
EKKO_AZURE_SPEECH_REGION=northeurope
EKKO_AZURE_SPEECH_LANGUAGE=da-DK

# ───────────────────────────────────────────────────────────
# OpenAI (LLM) - REQUIRED
# ───────────────────────────────────────────────────────────
# Get your API key from https://platform.openai.com/api-keys
EKKO_OPENAI_API_KEY=

# ───────────────────────────────────────────────────────────
# LLM Deployment and Model Configuration - OPTIONAL
# ───────────────────────────────────────────────────────────
# Default model deployment for summarization (uses gpt-4o-mini if not set).
# When configured, the summarizer service uses this model instead of the default.
# EKKO_LLM_DEFAULT_DEPLOYMENT=gpt-4o

# Optional fallback model deployments for LiteLLM Router.
# When configured, enables automatic fallback routing between models on transient failures.
# Router is only constructed when this list is explicitly configured and non-empty.
# Format: JSON array of model names or provider-qualified names.
# Example: ["gpt-4-turbo", "gpt-4", "anthropic/claude-3-opus"]
# EKKO_LLM_FALLBACK_DEPLOYMENTS=["gpt-4-turbo","gpt-4"]

# Generic LiteLLM provider settings for provider-qualified model names.
# Use these for custom providers or provider-qualified deployments (e.g., anthropic/claude).
# Existing LiteLLM providers can be selected with EKKO_LLM_PROVIDER=anthropic,
# cohere, or google; already-prefixed model names always take precedence.
# EKKO_LLM_PROVIDER=anthropic
# EKKO_LITELLM_API_KEY=
# EKKO_LITELLM_API_BASE=https://api.example.com/v1
# EKKO_LITELLM_API_VERSION=2024-10-01

# Enable optional cost tracking for LLM requests (default: false).
# When enabled, cost observations are recorded in metrics (prompts/completions not recorded).
# EKKO_LLM_TRACK_COSTS=false

# ───────────────────────────────────────────────────────────
# Azure OpenAI (Alternative to OpenAI) - OPTIONAL
# ───────────────────────────────────────────────────────────
# If using Azure OpenAI instead of OpenAI, uncomment and fill:
# EKKO_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# EKKO_AZURE_OPENAI_KEY=
# EKKO_AZURE_OPENAI_VERSION=2025-02-01-preview
# EKKO_LLM_PROVIDER=azure_openai

# ───────────────────────────────────────────────────────────
# Application Configuration
# ───────────────────────────────────────────────────────────
EKKO_ENVIRONMENT=local
EKKO_DEBUG=true
EKKO_HOST=127.0.0.1
EKKO_PORT=8000
EKKO_RELOAD=true

# ───────────────────────────────────────────────────────────
# GraphQL API Configuration
# ───────────────────────────────────────────────────────────
# REST is the canonical API surface; GraphQL exposes a single read-only prompt
# catalog query.
EKKO_GRAPHQL_ALLOW_GET_QUERIES=false
EKKO_GRAPHQL_ENABLE_IDE=true
EKKO_METRICS_ENABLED=true
EKKO_PII_POLICY_PROFILE=standard

# ───────────────────────────────────────────────────────────
# Audio Configuration
# ───────────────────────────────────────────────────────────
# Set to true to disable audio capture (useful for testing)
EKKO_DISABLE_AUDIO=false
EKKO_AUDIO_STREAMER_TCP_PORT=6600
EKKO_AUDIO_SAMPLE_RATE=48000
EKKO_AUDIO_CHANNELS=2

# ───────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────
EKKO_DATABASE_BACKEND=sqlite
EKKO_DATABASE_PATH=./ekko.db

EKKO_POSTGRESQL_HOST=127.0.0.1
EKKO_POSTGRESQL_PORT=5432
EKKO_POSTGRESQL_NAME=ekko
EKKO_POSTGRESQL_USER=postgres
# EKKO_POSTGRESQL_PASSWORD=
EKKO_POSTGRESQL_SSLMODE=prefer

# Optional full URL overrides (when set, these take precedence)
# EKKO_POSTGRESQL_ASYNC_DATABASE_URL_OVERRIDE=postgresql+asyncpg://<credentials>@<host>:5432/<database>
# EKKO_POSTGRESQL_SYNC_DATABASE_URL_OVERRIDE=postgresql+psycopg://<credentials>@<host>:5432/<database>

# Analytics pattern
# Runtime storage is SQLite. For analytics, export data to Parquet and analyze those files with DuckDB on demand.

# ───────────────────────────────────────────────────────────
# Logging Configuration
# ───────────────────────────────────────────────────────────
EKKO_LOG_LEVEL=INFO

# Optional Sentry DSN for error reporting
# EKKO_SENTRY_DSN=

# ───────────────────────────────────────────────────────────
# Redis (optional — required once running more than one replica)
# ───────────────────────────────────────────────────────────
# Shared store for rate limiting and cross-replica live-transcript fan-out.
# Unset by default: each process falls back to in-memory state, which is
# only correct with exactly one replica. The Docker Compose stack sets this
# to its own `redis` service automatically; uncomment for bare-metal local
# development against a Redis you run yourself.
# EKKO_REDIS_URL=redis://localhost:6379/0

# ───────────────────────────────────────────────────────────
# Local Observability (Docker profile) - OPTIONAL
# ───────────────────────────────────────────────────────────
EKKO_GRAFANA_ADMIN_USER=admin
EKKO_GRAFANA_ADMIN_PASSWORD=change-me
EKKO_GRAFANA_AUTH_ANONYMOUS_ENABLED=false

# Optional OpenTelemetry exporter endpoint for app instrumentation
# EKKO_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# ───────────────────────────────────────────────────────────
# Local Analytics (Matomo profile) - OPTIONAL
# ───────────────────────────────────────────────────────────
MATOMO_DB_ROOT_PASSWORD=matomo-root
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=matomo

# ───────────────────────────────────────────────────────────
# RAG Configuration
# ───────────────────────────────────────────────────────────
EKKO_RAG_EMBEDDING_MODEL=text-embedding-3-small
EKKO_RAG_LLM_MODEL=gpt-4o

# ───────────────────────────────────────────────────────────
# Prompt Registry / Versioning
# ───────────────────────────────────────────────────────────
# Allow the authoring CLI to snapshot changed prompt source files.
# Runtime named sets remain immutable and must be updated explicitly in the manifest.
EKKO_PROMPT_AUTO_PROVISION=true

# Local defaults to editable templates; dev/prod select their matching named set.
EKKO_PROMPT_VERSION_SET=experimental

# Optional: pin a specific immutable version for all prompts (example: v1.0)
# EKKO_PROMPT_VERSION=v1.0
