{
  "servers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus",
      "args": [
        "mcp"
      ],
      "cwd": "${workspaceFolder}"
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@1.9.0",
        "--isolated",
        "--headless",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "playwright": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "@playwright/mcp@0.0.80",
        "--isolated",
        "--headless"
      ]
    },
    "shadcn": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "shadcn@4.21.0",
        "mcp"
      ],
      "cwd": "${workspaceFolder}"
    },
    "postman": {
      "type": "http",
      "url": "https://mcp.postman.com/minimal"
    },
    "storybook": {
      "type": "http",
      "url": "http://localhost:6006/mcp"
    }
  }
}
