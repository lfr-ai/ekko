{
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": false,
  "terminal.integrated.env.windows": {
    "PATH": "${env:USERPROFILE}\\.local\\bin;${env:PATH}"
  },
  "editor.formatOnSave": true,
  "editor.tabCompletion": "on",
  "editor.rulers": [
    120
  ],
  "files.trimTrailingWhitespace": true,
  // Repo lives under OneDrive sync; excluding generated/cache dirs from the
  // watcher and search index avoids double-churn with the cloud sync client.
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/.tox/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.hypothesis/**": true,
    "**/.gitnexus/**": true,
    "**/logs/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.tox": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.hypothesis": true,
    "**/.gitnexus": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/uv.lock": true,
    "**/bun.lock": true
  },
  "cSpell.language": "en, da",
  // Let the workflow tooling own CI YAML instead of the generic YAML schema
  // (avoids false schema errors on GitHub Actions).
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
    "azure-pipelines.yml",
    "azure-pipelines.yaml"
  ],
  // Even Better TOML: keep array formatting stable across pyproject/config edits.
  "evenBetterToml.formatter.arrayAutoCollapse": true,
  "evenBetterToml.formatter.arrayAutoExpand": true,
  // SonarLint: focus findings on new/changed code (clean-as-you-code).
  "sonarlint.focusOnNewCode": true,
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "timonwong.shellcheck",
    "editor.codeActionsOnSave": {
      "source.fixAll.shellcheck": "explicit"
    }
  },
  "chat.useAgentSkills": true,
  "chat.defaultModel": "sonnet",
  "github.copilot.chat.claudeAgent.enabled": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "chat.hookFilesLocations": {
    ".github/hooks": true,
    ".claude/settings.json": false,
    ".claude/settings.local.json": false,
    "~/.claude/settings.json": false
  },
  "chat.useClaudeHooks": false,
  "chat.useAgentsMdFile": true,
  "chat.useClaudeMdFile": false,
  "chat.mcp.discovery.enabled": {
    "claude-desktop": false,
    "windsurf": false,
    "cursor-global": false,
    "cursor-workspace": false
  },
  "chat.mcp.autostart": "never",
  "chat.agent.maxRequests": 250,
  "github.copilot.chat.summarizeAgentConversationHistory.enabled": true,
  "chat.tools.compressOutput.enabled": true
}
