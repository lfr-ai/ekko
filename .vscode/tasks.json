{
  // ═══════════════════════════════════════════════════════════
  // Tasks Configuration for Ekko
  // ═══════════════════════════════════════════════════════════

  "version": "2.0.0",
  "tasks": [
    // ──────────────────────────────────────────────────────────
    // Backend Tasks
    // ──────────────────────────────────────────────────────────
    {
      "label": "Backend: Install Dependencies",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "UV_LINK_MODE": "copy"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Backend: Run Dev Server",
      "type": "shell",
      "command": "uv run uvicorn ekko.composition.app_factory:create_app --factory --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PYTHONPATH": "src;..",
          "UV_LINK_MODE": "copy"
        }
      },
      "group": "test",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Started reloader process.*$",
          "endsPattern": "^.*Application startup complete.*$"
        }
      }
    },
    {
      "label": "Backend: Run Tests",
      "type": "shell",
      "command": "uv run python -m pytest tests/ -v",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "UV_LINK_MODE": "copy"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Backend: Lint",
      "type": "shell",
      "command": "uv run python -m ruff check src",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "UV_LINK_MODE": "copy"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Backend: Format",
      "type": "shell",
      "command": "uv run python -m ruff format src",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "UV_LINK_MODE": "copy"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Backend: Type Check",
      "type": "shell",
      "command": "uv run python -m ty check src/ekko tests ../tests ../tools ../scripts ../registry alembic",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "UV_LINK_MODE": "copy"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Backend: Architecture",
      "type": "shell",
      "command": "uv run --project backend python tools/security/check_architecture_boundaries.py",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_LINK_MODE": "copy"
        }
      },
      "group": "test",
      "problemMatcher": []
    },

    // ──────────────────────────────────────────────────────────
    // Frontend Tasks
    // ──────────────────────────────────────────────────────────
    {
      "label": "Frontend: Install Dependencies",
      "type": "shell",
      "command": "bun install --frozen-lockfile",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "windows": {
        "options": {
          "cwd": "${workspaceFolder}/frontend",
          "env": {
            "BUN_INSTALL_CACHE_DIR": "${env:LOCALAPPDATA}\\bun\\install\\cache",
            "HOME": "${env:USERPROFILE}"
          }
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Architecture",
      "type": "shell",
      "command": "node ./scripts/check-architecture.mjs",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Run Dev Server",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      },
      "group": "test",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*VITE.*$",
          "endsPattern": "^.*Local:.*$"
        }
      }
    },
    {
      "label": "Frontend: Build",
      "type": "shell",
      "command": "bun run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Test",
      "type": "shell",
      "command": "bun run test",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Lint",
      "type": "shell",
      "command": "bun run lint",
      "options": {
        "cwd": "${workspaceFolder}/frontend",
        "env": {}
      },
      "group": "test",
      "problemMatcher": []
    },

    // ──────────────────────────────────────────────────────────
    // Compound Tasks
    // ──────────────────────────────────────────────────────────
    {
      "label": "Dev: Start Full Stack",
      "dependsOn": [
        "Backend: Run Dev Server",
        "Frontend: Run Dev Server"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Quality: Run All Checks",
      "dependsOn": [
        "Backend: Lint",
        "Backend: Architecture",
        "Backend: Type Check",
        "Backend: Run Tests",
        "Frontend: Lint",
        "Frontend: Architecture",
        "Frontend: Test"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
