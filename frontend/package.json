{
  "name": "ekko-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check . --skip=lint/nursery/useSortedClasses",
    "lint:fix": "biome check --write . --skip=lint/nursery/useSortedClasses",
    "format": "biome format --write .",
    "arch:check": "node ./scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "graphql:validate": "node ./scripts/validate-graphql-documents.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:storybook": "node ./scripts/test-storybook.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "shadcn": "shadcn",
    "ui:add": "shadcn add",
    "ui:diff": "shadcn diff"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@fast-check/vitest": "^0.1.6",
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.19.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-playwright": "^2.2.2",
    "esbuild": "^0.28.2",
    "fast-check": "^3.23.2",
    "happy-dom": "^16.8.1",
    "pathe": "^2.0.3",
    "rollup-plugin-visualizer": "^5.14.0",
    "shadcn": "^2.10.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
