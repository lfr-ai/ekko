# Copy to the ignored backend.dev.hcl and replace all placeholders.
# Authenticate with an Entra federated identity; do not add client secrets here.
# The identity needs Storage Blob Data Contributor on the state container.

resource_group_name  = "REPLACE_WITH_DEV_STATE_RESOURCE_GROUP"
storage_account_name = "REPLACE_WITH_DEV_STORAGE_ACCOUNT"
container_name       = "terraform-state"
key                  = "dev.terraform.tfstate"
subscription_id      = "REPLACE_WITH_DEV_SUBSCRIPTION_ID"
use_oidc             = true
use_azuread_auth     = true
