# Project-Specific (accidental root-level dirs)
# ═══════════════════════════════════════════════════════════════
/config
/core

# ═══════════════════════════════════════════════════════════════
# Terraform (azure/iac/terraform/)
# ═══════════════════════════════════════════════════════════════
# State files (MUST NOT be committed)
*.tfstate
*.tfstate.*

# Terraform directories (cache and plugins)
.terraform/
.tflint.d/

# Plan artifacts (MUST NOT be committed; validation-only tasks do not generate these)
*.tfplan
tfplan.*

# Local override files (may contain secrets)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
backend.*.hcl

# CLI cache and configuration
.terraformrc
terraform.rc
.terraform.d/

# Crash logs
crash.log
crash.*.log

# Exclude override files, but keep variable files
!*.tfvars
!*.tfvars.json

# Ignore CLI configuration file
cli-config.tfrc
