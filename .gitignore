# ═══════════════════════════════════════════════════════════════
# AI Tools and Agents
# ═══════════════════════════════════════════════════════════════
# Claude Code CLI (commit config + agents + rules + hooks, ignore runtime)
.claude/settings.local.json
.claude/agent-memory/
.claude/agent-memory-local/
.claude/worktrees/
.claude/projects/
.claude/scheduled_tasks.json
.claude/memory/
.claude/todos/
.claude/statsig/
CLAUDE.local.md

# Other AI agents
.copilot/

# GSD (Get Shit Done) — ignore all runtime state
.gsd/
.gsd-id

# Background shell processes
.bg-shell/

# ═══════════════════════════════════════════════════════════════
# GitNexus (commit config/hooks only)
# ═══════════════════════════════════════════════════════════════
.gitnexus/*
!.gitnexus/README.md
!.gitnexus/config.json
!.gitnexus/hooks/
!.gitnexus/hooks/*

