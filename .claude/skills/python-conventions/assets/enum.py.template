"""Enum template — copy anywhere a closed set of named values is needed.

Use ``StrEnum`` (wire-friendly, JSON/logging-safe) unless the values are
purely internal ordering, in which case ``IntEnum`` is acceptable. Always
``@unique`` — a duplicate value is a silent bug, not a style nit. Document
every member in a ``Members:`` docstring section (no ``Returns:``).
"""

from enum import StrEnum, unique


@unique
class ReplaceMeStatus(StrEnum):
    """One-line noun-phrase description of what this enumerates.

    Members:
        PENDING (str): Not yet processed.
        APPROVED (str): Processed and accepted.
        REJECTED (str): Processed and rejected.
    """

    PENDING = "pending"
    APPROVED = "approved"
    REJECTED = "rejected"


