{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 30,
  "env": {
    "PYTHONPATH": "backend/src",
    "UV_LINK_MODE": "copy",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "Bash(uv *)",
      "Bash(task *)",
      "Bash(python *)",
      "Bash(pre-commit *)",
      "Bash(pytest *)",
      "Bash(alembic *)",
      "Bash(ruff *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(tree *)",
      "Bash(diff *)",
      "Bash(docker *)",
      "Bash(docker compose *)",
      "Bash(powershell *)",
      "mcp__context7__*",
      "mcp__gitnexus__*"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf $HOME)",
      "Bash(git *)",
      "Bash(curl * | bash)",
      "Bash(wget * | bash)",
      "Bash(pip install *)",
      "Bash(npm install -g *)",
      "Bash(apt-get *)",
      "Bash(yum *)",
      "Bash(brew install *)",
      "Bash(choco install *)",
      "Bash(sudo *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agents/guard/tool-guardian.ts"
            ],
            "timeout": 30,
            "statusMessage": "Tool Guardian: enforcing read-only external resources..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agents/guard/license-guardian.ts"
            ],
            "timeout": 45,
            "statusMessage": "License Guardian: checking dependency license policy..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agents/guard/session-context.ts"
            ],
            "timeout": 30,
            "statusMessage": "Validating agent context entry files..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".venv",
      "__pycache__",
      ".pytest_cache",
      ".ruff_cache",
      ".mypy_cache",
      ".cache",
      "dist",
      "build",
      "*.egg-info"
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "repo-quality-gate@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "awaySummaryEnabled": true,
  "autoMemoryEnabled": true,
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "showMessageTimestamps": true,
  "todoFeatureEnabled": true
}
