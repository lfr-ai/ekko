{
  "name": "Ekko Dev Container",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24.21.0",
      "nodeGypDependencies": false
    }
  },
  "forwardPorts": [
    8000,
    5173,
    6006
  ],
  "portsAttributes": {
    "8000": {
      "label": "Ekko API"
    },
    "5173": {
      "label": "Ekko Frontend"
    },
    "6006": {
      "label": "Storybook"
    }
  },
  "mounts": [
    "source=ekko-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=ekko-precommit-cache,target=/home/vscode/.cache/pre-commit,type=volume"
  ],
  "remoteEnv": {
    "BUN_INSTALL": "/home/vscode/.bun",
    "PATH": "/home/vscode/.bun/bin:${containerEnv:PATH}",
    "PYTHONPATH": "/workspace/backend/src",
    "UV_LINK_MODE": "copy",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "EKKO_ENVIRONMENT": "local"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "astral-sh.ty",
        "task.vscode-task",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-azure-github-copilot",
        "ms-azuretools.vscode-azure-mcp-server",
        "ms-azuretools.vscode-bicep",
        "ms-vscode.azurecli",
        "ms-mssql.mssql",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "postman.postman-for-vscode",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "editorconfig.editorconfig",
        "DavidAnson.vscode-markdownlint",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-danish",
        "timonwong.shellcheck",
        "github.copilot-chat",
        "upstash.context7-mcp",
        "waderyan.gitblame",
        "codezombiech.gitignore",
        "vscode-icons-team.vscode-icons",
        "naumovs.color-highlight",
        "wayou.vscode-todo-highlight",
        "shd101wyy.markdown-preview-enhanced",
        "tomoki1207.pdf",
        "dvirtz.parquet-viewer",
        "ms-edgedevtools.vscode-edge-devtools",
        "neo4j-extensions.neo4j-for-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",
        "python.terminal.activateEnvironment": false
      }
    }
  },
  "postCreateCommand": "zsh .devcontainer/post-create.zsh",
  "postStartCommand": "zsh .devcontainer/post-start.zsh",
  "remoteUser": "vscode"
}
