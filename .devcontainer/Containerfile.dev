# syntax=docker/dockerfile:1
#
# Development container for Ekko.
# Used by VS Code Dev Containers via .devcontainer/compose.yml.
#
# DEVCONTAINER NOTES
# ------------------
# This Containerfile.dev follows a practical devcontainer setup:
# - Microsoft's official devcontainers Python base image for VSCode integration
# - uv for Python dependency management with link-mode copy
# - task (Taskfile.dev) for unified task running
# - hadolint for Dockerfile linting
# - shellcheck for shell script linting
# - zsh as default shell for vscode user
# - Comprehensive tooling for development workflow
#
# INTENTIONAL DEVIATIONS
# ----------------------
# 1. Apt packages NOT version-pinned.
#    Reason: Dev container reproducibility vs maintenance overhead tradeoff favors convenience.
#    Production Containerfile (docker/Containerfile) uses pinned base image tags for reproducibility.
# 2. Bun installed for frontend package management.
#    Reason: Project-specific frontend tooling choice for performance and modern workflows.

ARG BUN_VERSION=1.4.2
ARG TASK_VERSION=v3.48.0

FROM oven/bun:${BUN_VERSION} AS bun
FROM ghcr.io/astral-sh/uv:0.12.5 AS uv
FROM ghcr.io/hadolint/hadolint:v2.14.0-debian AS hadolint
FROM mcr.microsoft.com/devcontainers/python:3.15-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy

ARG TASK_VERSION

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=hadolint /bin/hadolint /usr/local/bin/hadolint

# hadolint ignore=DL3008
RUN rm -f /etc/apt/sources.list.d/yarn.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    jq \
    unzip \
    zsh \
    shellcheck \
    && rm -rf /var/lib/apt/lists/*

RUN sh -c "$(curl --location https://taskfile.dev/install.sh)" -- -d -b /usr/local/bin "${TASK_VERSION}"

RUN chsh -s /usr/bin/zsh vscode

WORKDIR /workspace
