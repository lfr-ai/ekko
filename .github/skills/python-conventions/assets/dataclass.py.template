"""Plain dataclass template — a data-holder that is NOT a domain concept.

Use this for infrastructure-local records (adapter-internal snapshots, mapper
intermediates, config-facet groupings) — anything without domain identity or
invariants worth a name in the ubiquitous language. A entity/value object/
domain event belongs in the `ddd` skill's templates instead
(`core/entities/`, `core/value_objects/`, `core/events/`), not here.
"""

from __future__ import annotations

from dataclasses import dataclass


@dataclass(frozen=True, kw_only=True, slots=True)
class ReplaceMeRecord:
    """One-line noun-phrase description of what this record holds."""

    identifier: str
    label: str


