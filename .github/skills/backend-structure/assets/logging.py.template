"""Structured logging setup template — copy into infrastructure/logging.py,
call `configure_logging()` once from the app factory/composition root before
constructing the app.

Stdlib `logging` only — logging is an infrastructure concern, never a
framework dependency leaked into Core/Application. Configuration is
idempotent (safe to call more than once, e.g. in tests) and adds structured
`key=value` extras plus request-scoped context (correlation/request ID)
without requiring call sites to format them by hand.
"""

from __future__ import annotations

import logging
import logging.handlers
from pathlib import Path

_LOG_FORMAT = "%(asctime)s %(levelname)s %(name)s %(message)s%(extras)s"
_RESERVED_RECORD_ATTRS = frozenset(logging.LogRecord("", 0, "", 0, "", (), None).__dict__)


class _ExtrasFormatter(logging.Formatter):
    """Append any `extra=` keyword arguments as trailing `key=value` pairs."""

    def format(self, record: logging.LogRecord) -> str:
        """Render one log record with its structured extras appended."""
        extras = {
            key: value
            for key, value in record.__dict__.items()
            if key not in _RESERVED_RECORD_ATTRS
        }
        record.extras = "" if not extras else " " + " ".join(
            f"{key}={value}" for key, value in sorted(extras.items())
        )
        return super().format(record)


class _RequestContextFilter(logging.Filter):
    """Inject request-scoped context (e.g. a correlation ID) into every record.

    Replace `_current_request_id()` with the project's actual context source
    (a `contextvars.ContextVar` set by request middleware), not a global.
    """

    def filter(self, record: logging.LogRecord) -> bool:
        """Attach the current request ID to the record, when one is bound."""
        record.request_id = _current_request_id()
        return True


def _current_request_id() -> str | None:
    """Placeholder — replace with a `contextvars.ContextVar` lookup."""
    return None


def configure_logging(*, log_dir: Path, level: int = logging.INFO) -> None:
    """Configure application-wide logging, replacing any prior handlers.

    Idempotent: clears existing root handlers first so repeated calls (e.g.
    across test modules that each build an app) never duplicate output.

    Args:
        log_dir (Path): Directory that rotated log files are written to.
        level (int): Root logger level. Defaults to `logging.INFO`.
    """
    log_dir.mkdir(parents=True, exist_ok=True)

    formatter = _ExtrasFormatter(_LOG_FORMAT)
    file_handler = logging.handlers.TimedRotatingFileHandler(
        log_dir / "app.log", when="midnight", backupCount=14, encoding="utf-8"
    )
    file_handler.setFormatter(formatter)
    file_handler.addFilter(_RequestContextFilter())

    stream_handler = logging.StreamHandler()
    stream_handler.setFormatter(formatter)
    stream_handler.addFilter(_RequestContextFilter())

    root_logger = logging.getLogger()
    root_logger.setLevel(level)
    root_logger.handlers.clear()
    root_logger.addHandler(file_handler)
    root_logger.addHandler(stream_handler)
