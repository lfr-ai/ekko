"""Value object template — copy into core/value_objects/, rename, fill fields.

A value object has NO identity; equality is structural (all fields equal).
Extract one when you see primitive obsession, a cohesive attribute group, or a
validation rule that keeps getting copy-pasted next to a primitive field.

Dataclasses generate a field-wise ``__repr__``; retain it by default. Override
``__repr__`` only when it would disclose a secret or personal identifier, then
keep the type name and mask the sensitive value (see the python-conventions
skill's ``references/dunder-patterns.md``). For sensitive or potentially large
dataclass fields, use ``field(repr=False)`` instead of hand-writing a whole
``__repr__``.
"""

from __future__ import annotations

from dataclasses import dataclass
from decimal import Decimal


@dataclass(frozen=True, kw_only=True, slots=True)
class ReplaceMeValueObject:
    """One-line noun-phrase description of the concept this represents."""

    amount: Decimal
    unit: str

    def __post_init__(self):  # noqa: ANN204
        """Validate the constraints that make an instance well-formed."""
        if self.amount < 0:
            raise ValueError("amount must not be negative")
        if not self.unit:
            raise ValueError("unit must not be empty")

    def add(self, other: ReplaceMeValueObject) -> ReplaceMeValueObject:
        """Combine two instances of the same unit, returning a new instance."""
        if self.unit != other.unit:
            raise ValueError("cannot combine different units")
        return ReplaceMeValueObject(amount=self.amount + other.amount, unit=self.unit)
